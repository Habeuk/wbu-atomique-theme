{
  "name": "stan-compiler",
  "version": "1.0.0",
  "description": "module webpack pour la compilation de mes fichier",
  "main": "src/index.js",
  "scripts": {
    "DevAll": "webpack --watch --node-env='development' --progress",
    "Dev": "NODE_ENV=development node dev-optimized.js",
    "buildAll": "--node-env=production webpack --watch --progress",
    "build": "NODE_ENV=production node build-independent.js",
    "ProdAll": "webpack --node-env='production' --watch --progress",
    "Prod": "NODE_ENV=production node dev-optimized.js",
    "Prod:custom": "NODE_ENV=production node build-independent.js --custom",
    "ProdCMD": "NODE_ENV=production node build-independent.js",
    "DevCMD": "NODE_ENV=development node build-independent.js",
    "serve": "webpack serve --mode='production' --open",
    "build:indep-fast": "NODE_ENV=development node build-independent.js --fast",
    "build:indep-safe": "NODE_ENV=development node build-independent.js --safe",
    "build:custom": "NODE_ENV=development node build-independent.js --custom"
  },
  "author": "gugledas",
  "license": "ISC",
  "engines": {
    "node": ">=22.4.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^9.22.0",
    "eslint-webpack-plugin": "^5.0.0",
    "globals": "^16.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.85.1",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "browserslist": [
    ">1%",
    "not ie 11"
  ],
  "dependencies": {
    "@stephane888/wbu-atomique": "file:../../AppVuejs/wbu-atomique"
  }
